# =============================================================
# Caddyfile - Generado por Ansible
# No editar directamente en el servidor
# Modificar en templates/Caddyfile.j2 y correr el playbook
# =============================================================

(seguridad) {
    header {
        # Obliga a los navegadores a usar siempre HTTPS (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Evita que alguien incruste tu sitio en un <iframe> oculto (Clickjacking)
        X-Frame-Options "DENY"
        
        # Bloquea ataques de inyección donde intentan engañar el tipo de archivo
        X-Content-Type-Options "nosniff"
        
        # Le quita la etiqueta "Caddy" a las respuestas del servidor
        -Server
    }
}

# ── iteravirtus.cl ───────────────────────────────────────────
iteravirtus.cl, www.iteravirtus.cl {
    import seguridad

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://iteravirtus.cl https://pub-f3626c2bde8847c29fd8c3602b76dca2.r2.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
        -X-Powered-By
    }

    log {
        output file /var/log/caddy/iteravirtus_access.log {
            roll_size 10mb
            roll_keep 10
        }
        level info
    }

    @frontend {
        not path /api/*
        not path /admin/*
        not path /static/*
    }
    reverse_proxy @frontend {{ iteravirtus_ip }}:5173 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /api/* {{ iteravirtus_ip }}:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /admin/* {{ iteravirtus_ip }}:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /static/* {{ iteravirtus_ip }}:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── cicpol.synatrix.io ───────────────────────────────────────
cicpol.synatrix.io {
    import seguridad
    encode zstd gzip

    handle /live/*/whip {
        reverse_proxy {{ cicpol_ip }}:8889
    }
    handle /live/*/whep {
        reverse_proxy {{ cicpol_ip }}:8889
    }

    handle /stream/* {
        uri strip_prefix /stream
        reverse_proxy {{ cicpol_ip }}:8888
    }

    handle_path /voice/* {
        reverse_proxy {{ cicpol_ip }}:8089 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    handle_path /tak-bridge/* {
        reverse_proxy {{ cicpol_ip }}:8200
    }

    handle_path /api/tak/* {
        reverse_proxy {{ cicpol_ip }}:8200
    }

    handle_path /matomo/* {
        reverse_proxy {{ cicpol_ip }}:8081
    }

    handle /api* {
        reverse_proxy {{ cicpol_ip }}:8085
    }

    @mumbleWS {
        header Connection *Upgrade*
        header Upgrade websocket
        not path /live/*
        not path /stream/*
    }
    handle @mumbleWS {
        reverse_proxy {{ cicpol_ip }}:8089 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle {
        reverse_proxy {{ cicpol_ip }}:3030
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output file /var/log/caddy/cicpol_synatrix.log
    }
}

# ── tak.cicpol.synatrix.io ──────────────────────────────────
tak.cicpol.synatrix.io {
    import seguridad

    encode zstd gzip

    reverse_proxy {{ cicpol_ip }}:8443 {
        transport http {
            tls_insecure_skip_verify
        }
    }

    log {
        output file /var/log/caddy/tak_cicpol.log
    }
}

# ── verintia.com ─────────────────────────────────────────────
verintia.com, www.verintia.com {
    import seguridad

    reverse_proxy {{ verintia_ip }}:80
}

# ── errors.iteravirtus.cl (GlitchTip) ───────────────────────
errors.iteravirtus.cl {
    import seguridad

    reverse_proxy localhost:8001

    log {
        output file /var/log/caddy/glitchtip_access.log {
            roll_size 10mb
            roll_keep 10
        }
        level info
    }
}

